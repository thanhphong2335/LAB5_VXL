#include "fsm.h"

CommandParserState CommandParserState = WAITING_FOR_COMMAND;
CommandCommunicationState CommandCommunicationState = IDLE;

extern ADC_HandleTypeDef hadc1;
extern UART_HandleTypeDef huart2;

void command_parser_fsm(){
	switch (CommandParserState){
		case WAITING_FOR_COMMAND:
			if(buffer_flag ==1){
				CommandParserState=PARSING_COMMAND;
			}
			break;
		case PARSING_COMMMAND:
			if(strncmp( (char*)buffer_index,"!RTS#",5 )==0){
				flag_send_fsm = 1;
				CommandParserState = COMPLETED_COMMAND;
				last_receive_time = HAL_GetTick();
			}
			if(strncmp( (char*)buffer_index,"!OK#",5) ==0){
				flag_stop_fsm =1;
				CommandParserState = COMPLETED_COMMAND;
			}
			break;
		case COMPLETED_COMMAND:
			flag_send_fsm =0;
			flag_stop_fsm =0;
			CommandParserState = WAITING_FOR_COMMAND;
			break;
		}
	if (HAL_GetTick() - last_receive_time > 3000 && !timeout_flag) {
		timeout_flag = 1;
		flag_send_fsm = 1;
	}
}

void uart_communication_fsm(){
	switch (CommandCommunicationState){
		case IDLE:
			if(flag_send_fsm == 1){
				CommandCommunicationState = SEND;
			}
			else if(flag_stop_fsm == 1){
				CommandCommunicationState = STOP;
			}
		case SEND:
			uint8_t ADC_value = HAL_ADC_GetValue(&hadc1);
			char str[30];
			sprintf(str, "!ADC=%ld#", ADC_value);
			HAL_UART_Transmit( &huart2, (uint8_t *)str, strlen(str), 1000);
			timeout_flag = 0;
			CommandCommunicationState= IDLE;
		case STOP:
			CommandCommunicationState= IDLE;
			break;
}
