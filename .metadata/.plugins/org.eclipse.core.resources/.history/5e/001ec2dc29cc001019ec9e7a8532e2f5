#include "fsm.h"
#include <stdio.h>
#include <string.h>

// Khai báo biến state
CommandParserState parserState = WAITING_FOR_COMMAND;
CommandCommunicationState commState = IDLE;

// Khai báo extern các biến từ main
extern ADC_HandleTypeDef hadc1;
extern UART_HandleTypeDef huart2;

// Các biến buffer từ main.c (cần đảm bảo bên main.c đã khai báo)
extern uint8_t buffer[];
extern uint8_t index_buffer;
extern uint8_t buffer_flag;

// Cờ hiệu điều khiển
uint8_t flag_rst = 0;
uint8_t flag_ok = 0;

uint32_t last_receive_time = 0;

void command_parser_fsm(){
    switch (parserState){
        case WAITING_FOR_COMMAND:
            if(buffer_flag == 1){
                parserState = PARSING_COMMAND;
                buffer_flag = 0; // Xóa cờ sau khi nhận
            }
            break;

        case PARSING_COMMAND:
            // SỬA LỖI: Dùng mảng 'buffer' để so sánh chuỗi, không dùng 'index_buffer'
            if(strncmp((char*)buffer, "!RST#", 5) == 0){
                flag_rst = 1;  // Bật cờ RST
                parserState = COMPLETED_COMMAND;
            }
            else if(strncmp((char*)buffer, "!OK#", 4) == 0){
                flag_ok = 1;   // Bật cờ OK
                parserState = COMPLETED_COMMAND;
            }
            else {
                // Nếu lệnh sai hoặc chưa đủ, chờ tiếp hoặc reset tùy logic buffer của bạn
                // Ở đây giả sử reset về chờ nếu sai
                parserState = COMPLETED_COMMAND;
            }
            break;

        case COMPLETED_COMMAND:
            // Reset các chỉ số buffer để nhận lệnh mới
            index_buffer = 0;
            // Lưu ý: buffer_flag đã được set = 0 ở case WAITING hoặc xử lý ngắt
            parserState = WAITING_FOR_COMMAND;
            break;
     }
}

void uart_communication_fsm(){
    char str[50];
    uint32_t ADC_value = 0;

    switch (commState){
        case IDLE:
            // Nếu nhận lệnh !RST#
            if(flag_rst == 1){
                flag_rst = 0; // Xóa cờ

                // Đọc giá trị ADC LẦN ĐẦU
                ADC_value = HAL_ADC_GetValue(&hadc1);
                sprintf(str, "!ADC=%lu#\r\n", ADC_value);
                HAL_UART_Transmit(&huart2, (uint8_t *)str, strlen(str), 1000);

                last_receive_time = HAL_GetTick(); // Ghi lại thời gian
                commState = SEND; // Chuyển sang trạng thái chờ (SEND/WAIT)
            }
            break;

        case SEND: // Trạng thái này tương đương với WAIT_FOR_TIMEOUT
            // 1. Nếu nhận lệnh !OK# -> Dừng gửi, về IDLE
            if(flag_ok == 1){
                flag_ok = 0;
                commState = IDLE;
            }
// 2. Nếu nhận tiếp lệnh !RST# (Reset nóng) -> Gửi ngay lập tức
            else if(flag_rst == 1){
            	flag_rst = 0;
            	ADC_value = HAL_ADC_GetValue(&hadc1); // Đọc giá trị MỚI
				sprintf(str, "!ADC=%lu#\r\n", ADC_value);
				HAL_UART_Transmit(&huart2, (uint8_t *)str, strlen(str), 1000);
				last_receive_time = HAL_GetTick(); // Reset timer
            }
            // 3. Xử lý Timeout 3 giây (3000ms)
            else if(HAL_GetTick() - last_receive_time >= 3000){

                // --- CHÌA KHÓA CỦA YÊU CẦU BẠN NẰM Ở ĐÂY ---
                // Thay vì gửi lại giá trị cũ, ta gọi hàm đọc ADC một lần nữa
                ADC_value = HAL_ADC_GetValue(&hadc1);
                // ------------------------------------------

                sprintf(str, "!ADC=%lu#\r\n", ADC_value);
                HAL_UART_Transmit(&huart2, (uint8_t *)str, strlen(str), 1000);

                last_receive_time = HAL_GetTick(); // Reset timer lại 3s
            }
            break;

        case STOP:
            // Case này có thể bỏ nếu gộp logic vào IDLE như trên,
            // nhưng giữ lại để tương thích code cũ nếu cần.
            commState = IDLE;
            break;
    }
}
