#include "fsm.h"

void command_parser_fsm(){
	switch (CommandParserState){
	case WAITING_FOR_COMMAND:
		if(buffer_flag ==1){
			CommandParserState=PARSING_COMMAND;
		}
		if(timer_flag0 = 1){

		}
		break;
	case PARSING_COMMMAND:
		if(strncmp( (char*)buffer_index,"!RTS#",5 )==0){
			flag_send_fsm = 1;
			CommandParserState = COMPLETED_COMMAND;
		}
		if(strncmp( (char*)buffer_index,"!OK#",5) ==0){
			flag_stop_fsm =1;
			CommandParserState = COMPLETED_COMMAND;
		}
		break;
	case COMPLETED_COMMAND:
		flag_send_fsm =0;
		flag_stop_fsm =0;
		CommandParserState = WAITING_FOR_COMMAND;
	}
}

void uart_communication_fsm(){
	switch (CommandCommunicationState){
		case IDLE:
			if(flag_send_fsm == 1){
				CommandCommunicationState = SEND;
			}
			else if(flag_stop_fsm == 1){
				CommandCommunicationState = STOP;
			}
		case SEND:
			uint8_t ADC_value = HAL_ADC_GetValue(&hadc1);
			char str[30];
			HAL_UART_Transmit(&huart2, (void *)str, sprintf(str, "%d\n", ADC_value), 1000);	}
}
