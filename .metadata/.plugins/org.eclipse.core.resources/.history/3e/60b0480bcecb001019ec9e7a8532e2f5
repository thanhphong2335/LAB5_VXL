#include "fsm.h"
#include <stdio.h>

// Khai báo biến state
CommandParserState parserState = WAITING_FOR_COMMAND;
CommandCommunicationState commState = IDLE;

// Khai báo extern các biến cần thiết từ main
extern ADC_HandleTypeDef hadc1;
extern UART_HandleTypeDef huart2;

void command_parser_fsm(){
	char debug_msg[50];

	switch (parserState){
		case WAITING_FOR_COMMAND:
			if(buffer_flag == 1){
				parserState = PARSING_COMMAND;

				// DEBUG: In buffer nhận được
				sprintf(debug_msg, "[BUFFER: %s]\r\n", buffer_index);
				HAL_UART_Transmit(&huart2, (uint8_t*)debug_msg, strlen(debug_msg), 100);
			}
			break;

		case PARSING_COMMAND:
			// DEBUG: Kiểm tra so sánh
			sprintf(debug_msg, "[PARSING...]\r\n");
			HAL_UART_Transmit(&huart2, (uint8_t*)debug_msg, strlen(debug_msg), 100);

			// So sánh lệnh RTS
			if(strncmp((char*)buffer_index, "RTS", 3) == 0){
				sprintf(debug_msg, "[RTS MATCHED!]\r\n");
				HAL_UART_Transmit(&huart2, (uint8_t*)debug_msg, strlen(debug_msg), 100);

				flag_send_fsm = 1;
				parserState = COMPLETED_COMMAND;
				last_receive_time = HAL_GetTick();
				timeout_flag = 0;
			}
			// So sánh lệnh OK
			else if(strncmp((char*)buffer_index, "OK", 2) == 0){
				sprintf(debug_msg, "[OK MATCHED!]\r\n");
				HAL_UART_Transmit(&huart2, (uint8_t*)debug_msg, strlen(debug_msg), 100);

				flag_stop_fsm = 1;
				parserState = COMPLETED_COMMAND;
				timeout_flag = 0;
			}
			else {
				sprintf(debug_msg, "[UNKNOWN CMD]\r\n");
				HAL_UART_Transmit(&huart2, (uint8_t*)debug_msg, strlen(debug_msg), 100);

				buffer_flag = 0;
				indexbuff = 0;
				parserState = WAITING_FOR_COMMAND;
			}
			break;

		case COMPLETED_COMMAND:
			sprintf(debug_msg, "[COMPLETED]\r\n");
			HAL_UART_Transmit(&huart2, (uint8_t*)debug_msg, strlen(debug_msg), 100);

			buffer_flag = 0;
			indexbuff = 0;
			parserState = WAITING_FOR_COMMAND;
			break;
	}

	// Timeout - tự động gửi sau 3 giây
	if (last_receive_time > 0 &&
	    HAL_GetTick() - last_receive_time >= 3000 &&
	    !timeout_flag) {
		timeout_flag = 1;
		flag_send_fsm = 1;
		last_receive_time = HAL_GetTick();
	}
}

void uart_communication_fsm(){
	uint32_t ADC_value;
	char str[50];

	switch (commState){
		case IDLE:
			if(flag_send_fsm == 1){
				sprintf(str, "[SENDING...]\r\n");
				HAL_UART_Transmit(&huart2, (uint8_t*)str, strlen(str), 100);

				commState = SEND;
				flag_send_fsm = 0;
			}
			else if(flag_stop_fsm == 1){
				commState = STOP;
				flag_stop_fsm = 0;
			}
			break;

		case SEND:
			ADC_value = HAL_ADC_GetValue(&hadc1);
			sprintf(str, "!ADC=%lu#\r\n", ADC_value);
			HAL_UART_Transmit(&huart2, (uint8_t *)str, strlen(str), 1000);
			commState = IDLE;
			break;

		case STOP:
			sprintf(str, "[STOPPED]\r\n");
			HAL_UART_Transmit(&huart2, (uint8_t*)str, strlen(str), 100);

			timeout_flag = 0;
			last_receive_time = 0;
			commState = IDLE;
			break;
	}
}
