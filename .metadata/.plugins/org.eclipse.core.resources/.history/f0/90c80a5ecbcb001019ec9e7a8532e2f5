#include "fsm.h"
#include <stdio.h>

// Khai báo biến state với tên khác để tránh xung đột
CommandParserState parserState = WAITING_FOR_COMMAND;
CommandCommunicationState commState = IDLE;

// Khai báo extern các biến cần thiết từ main
extern ADC_HandleTypeDef hadc1;
extern UART_HandleTypeDef huart2;

void command_parser_fsm(){
	switch (parserState){
		case WAITING_FOR_COMMAND:
			if(buffer_flag == 1){
				parserState = PARSING_COMMMAND;  // Chú ý: PARSING_COMMMAND (3 chữ M)
			}
			break;
		case PARSING_COMMMAND:
			if(strncmp((char*)buffer_index, "!RTS#", 5) == 0){
				flag_send_fsm = 1;
				parserState = COMPLETED_COMMAND;
				last_receive_time = HAL_GetTick();
			}
			if(strncmp((char*)buffer_index, "!OK#", 4) == 0){
				flag_stop_fsm = 1;
				parserState = COMPLETED_COMMAND;
			}
			break;
		case COMPLETED_COMMAND:
			flag_send_fsm = 0;
			flag_stop_fsm = 0;
			buffer_flag = 0;
			indexbuff = 0;
			parserState = WAITING_FOR_COMMAND;
			break;
	}
	if (HAL_GetTick() - last_receive_time > 3000 && !timeout_flag) {
		timeout_flag = 1;
		flag_send_fsm = 1;
	}
}

void uart_communication_fsm(){
	uint32_t ADC_value;
	char str[30];

	switch (commState){
		case IDLE:
			if(flag_send_fsm == 1){
				commState = SEND;
			}
			else if(flag_stop_fsm == 1){
				commState = STOP;
			}
			break;

		case SEND:
			ADC_value = HAL_ADC_GetValue(&hadc1);
			sprintf(str, "!ADC=%lu#", ADC_value);
			HAL_UART_Transmit(&huart2, (uint8_t *)str, strlen(str), 1000);
			timeout_flag = 0;
			commState = IDLE;
			break;

		case STOP:
			commState = IDLE;
			break;
	}
}
